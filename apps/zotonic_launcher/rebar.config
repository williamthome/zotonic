%% -*- mode: erlang -*-

{minimum_otp_vsn, "26"}.

{erl_opts, [
    debug_info
]}.


{deps,
 [
    zotonic_core,
    zotonic_filewatcher,
    zotonic_fileindexer,
    zotonic_filehandler,
    zotonic_listen_http,
    zotonic_listen_smtp,
    {yamerl, "~> 0.8"},
    %% Git ref until cowmachine releases its pluggable server.
    {cowmachine, {git, "https://github.com/williamthome/cowmachine.git", {branch, "feat/pluggable-server"}}}
 ]
}.

{plugins, []}.

{xref_checks, [undefined_function_calls,
               locals_not_used,
               deprecated_function_calls]}.

{project_plugins, [rebar3_ex_doc]}.
{hex, [{doc, ex_doc}]}.

